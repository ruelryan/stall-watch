# Copy to .env.local for local development. Values never go in this file or in git.
#
# Both variables are exposed to the browser (NEXT_PUBLIC_ prefix). They are safe to expose:
# the anon/publishable key only grants what row level security allows.
# There is deliberately NO service-role key: the app never uses one (schema rule 6).

# Supabase project URL. Local: http://127.0.0.1:54321 (printed by `supabase start`).
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (publishable) key. Local: printed by `supabase start` / `supabase status`.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
